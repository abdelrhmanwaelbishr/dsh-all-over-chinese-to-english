{
  "name": "dsh-all-over-chinese-to-english",
  "version": "1.1.0",
  "private": false,
  "description": "Translates Chinese text across the DSH interface - plugin pages, settings, dropdown menus, plugin view tabs, iframe panels, and the agent's own chat text - into English.",
  "type": "module",
  "license": "MIT",
  "author": "Abdelrhman Bishr",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abdelrhmanwaelbishr/dsh-all-over-chinese-to-english.git"
  },
  "homepage": "https://github.com/abdelrhmanwaelbishr/dsh-all-over-chinese-to-english#readme",
  "bugs": {
    "url": "https://github.com/abdelrhmanwaelbishr/dsh-all-over-chinese-to-english/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "translation",
    "chinese",
    "localization"
  ],
  "icon": "./icon.png",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.png",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
